<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Authors>syedibrahim369</Authors>
    <Product>huh</Product>
    <Version>1.0.0</Version>
    <Copyright>Copyright (c) 2026 syedibrahim369</Copyright>
  </PropertyGroup>
  <!-- Release binaries must not carry the build machine's paths (they include the Windows user name): map the repo root to
       /_/ in PDB paths and compiler-generated strings, as CI builds do. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Deterministic>true</Deterministic>
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))=/_/</PathMap>
    <!-- The trimmer (ILLink) writes its own output PDB path (obj\...\linked\Huh.pdb, full path) into the binary despite PathMap,
         so Release builds carry no PDB at all. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
