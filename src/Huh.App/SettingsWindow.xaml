<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Huh.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="huh settings">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (content extends into it so Mica covers the whole window). -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/huh-256.png" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="huh settings" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" Padding="28,8,28,28" Spacing="4">
                <StackPanel.Resources>
                    <Style x:Key="Card" TargetType="Border">
                        <Setter Property="Padding" Value="16,12" />
                        <Setter Property="CornerRadius" Value="6" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                    </Style>
                    <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                        <Setter Property="Margin" Value="2,20,0,6" />
                    </Style>
                    <Style x:Key="CardDescription" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                </StackPanel.Resources>

                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="2,8,0,0" />

                <!-- ============================== General -->
                <TextBlock Text="General" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Watch for error messages" />
                            <TextBlock x:Name="WatchDescription" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="WatchToggle" Grid.Column="1" OnContent="On" OffContent="Paused" Toggled="OnWatchToggled"
                                      AutomationProperties.Name="Watch for error messages" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Start with Windows" />
                            <TextBlock x:Name="StartupDescription" Style="{StaticResource CardDescription}"
                                       Text="Starts huh when you sign in, for your Windows account only. Off by default." />
                        </StackPanel>
                        <ToggleSwitch x:Name="StartupToggle" Grid.Column="1" Toggled="OnStartupToggled" AutomationProperties.Name="Start with Windows" />
                    </Grid>
                </Border>

                <!-- ============================== AI -->
                <TextBlock Text="AI explanations" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Explain errors with AI" />
                            <TextBlock x:Name="AiDescription" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AiToggle" Grid.Column="1" Toggled="OnAiToggled" AutomationProperties.Name="Explain errors with AI" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="12" RowSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Provider" />
                            <TextBlock Style="{StaticResource CardDescription}" Text="A local model with Ollama is planned (nothing would leave your PC)." />
                        </StackPanel>
                        <ComboBox x:Name="ProviderBox" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                  AutomationProperties.Name="AI provider" SelectedIndex="0">
                            <ComboBoxItem Content="Google Gemini (free tier)" />
                            <ComboBoxItem Content="Ollama on this PC (coming later)" IsEnabled="False" />
                        </ComboBox>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <TextBlock Text="Model" />
                            <TextBlock Style="{StaticResource CardDescription}" Text="Used first." />
                        </StackPanel>
                        <ComboBox x:Name="ModelBox" Grid.Row="1" Grid.Column="1" IsEditable="True" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="Model" TextSubmitted="OnModelSubmitted" SelectionChanged="OnModelSelected" />

                        <StackPanel Grid.Row="2" VerticalAlignment="Center">
                            <TextBlock Text="Fallback model" />
                            <TextBlock Style="{StaticResource CardDescription}" Text="Tried when the first one is busy, out of free quota or slow." />
                        </StackPanel>
                        <ComboBox x:Name="FallbackBox" Grid.Row="2" Grid.Column="1" IsEditable="True" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="Fallback model" TextSubmitted="OnModelSubmitted" SelectionChanged="OnModelSelected" />

                        <TextBlock x:Name="ModelMessage" Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource CardDescription}" Visibility="Collapsed" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Gemini API key" />
                        <TextBlock x:Name="KeyStatus" Style="{StaticResource CardDescription}" />
                        <Grid x:Name="KeyEntry" ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <PasswordBox x:Name="KeyBox" PlaceholderText="Paste a new key" AutomationProperties.Name="New Gemini API key" PasswordChanged="OnKeyChanged" />
                            <Button x:Name="SaveKeyButton" Grid.Column="1" Content="Save key" IsEnabled="False" Click="OnSaveKey" />
                            <Button x:Name="RemoveKeyButton" Grid.Column="2" Content="Remove saved key" Click="OnRemoveKey" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============================== Exclusions -->
                <TextBlock Text="Excluded apps" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource CardDescription}"
                                   Text="huh ignores error messages from these apps. Use this for apps whose messages you already understand, or that huh gets wrong." />
                        <StackPanel x:Name="ExcludedList" Spacing="4" />
                        <TextBlock x:Name="ExcludedEmpty" Text="No apps are excluded." Style="{StaticResource CardDescription}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="RecentBox" HorizontalAlignment="Stretch" PlaceholderText="Pick an app huh has seen an error from"
                                      AutomationProperties.Name="Recently seen apps" SelectionChanged="OnRecentSelected" />
                            <Button x:Name="ExcludeButton" Grid.Column="1" Content="Exclude" IsEnabled="False" Click="OnExclude" />
                        </Grid>
                        <TextBlock x:Name="RecentEmpty" Style="{StaticResource CardDescription}" Visibility="Collapsed"
                                   Text="Apps show up here after huh has shown a bubble for one of their error messages." />
                    </StackPanel>
                </Border>

                <!-- ============================== Privacy -->
                <TextBlock Text="Privacy" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="PrivacyWhen" TextWrapping="Wrap" />

                        <StackPanel Spacing="3">
                            <TextBlock Text="Sent to Google, once per new error" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource CardDescription}"
                                       Text="• The message's title, text (up to 2,000 characters) and button labels." />
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource CardDescription}"
                                       Text="• huh's own facts: program name and exe, signature, whether it runs as administrator, whether it's part of Windows, and the decoded error codes." />
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource CardDescription}"
                                       Text="• huh's fixed instructions to the model (the same for every request)." />
                        </StackPanel>
                        <StackPanel Spacing="3">
                            <TextBlock Text="Removed before sending" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource CardDescription}"
                                       Text="• Your user-folder path (replaced with %USERPROFILE%), other users' folder names, your user name, your computer name and e-mail addresses." />
                        </StackPanel>
                        <StackPanel Spacing="3">
                            <TextBlock Text="Never sent" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource CardDescription}"
                                       Text="• Screenshots (huh never takes any), file contents, other windows, your settings and exclusions. Your API key goes only to Google, in a request header." />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Text="On the Gemini API free tier, Google may use what is sent to improve its products, and people may review it. Don't turn AI on if your error messages can contain confidential information." />

                        <Expander x:Name="PreviewExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Expanding="OnPreviewExpanding">
                            <Expander.Header>
                                <StackPanel Padding="0,6">
                                    <TextBlock Text="See exactly what gets sent" />
                                    <TextBlock Style="{StaticResource CardDescription}" Text="Built by the same code as a real request. Nothing is sent from here." />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Spacing="8">
                                <ComboBox x:Name="PreviewSource" SelectionChanged="OnPreviewSourceChanged" AutomationProperties.Name="Preview for">
                                    <ComboBoxItem Content="A sample error (with your real user folder, to show the redaction)" />
                                    <ComboBoxItem x:Name="PreviewLastItem" Content="The last error huh showed (this session)" />
                                </ComboBox>
                                <TextBox x:Name="PreviewText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="420"
                                         FontFamily="Cascadia Mono, Consolas" FontSize="12" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="Exact request preview" />
                            </StackPanel>
                        </Expander>

                        <StackPanel Spacing="3">
                            <TextBlock Text="Stored on this PC" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="StoredText" TextWrapping="Wrap" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ClearCacheButton" Content="Delete saved AI answers" Click="OnClearCache" />
                            <Button Content="Open huh's data folder" Click="OnOpenData" />
                        </StackPanel>
                        <TextBlock x:Name="PrivacyResult" Style="{StaticResource CardDescription}" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- ============================== About -->
                <TextBlock Text="About" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="AboutText" />
                        <TextBlock Style="{StaticResource CardDescription}"
                                   Text="huh reads dialog text through UI Automation only. It can't read messages from apps running as administrator unless huh also runs as administrator (it doesn't, by default)." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
