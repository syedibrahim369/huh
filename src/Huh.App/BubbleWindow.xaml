<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Huh.BubbleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="huh">

    <Grid x:Name="Root" VerticalAlignment="Top" Padding="16,10,8,10" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: severity glyph, brand, dismiss -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="SeverityIcon" FontSize="16" Glyph="&#xEB90;" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="huh?" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Grid.Column="2" Width="32" Height="28" Padding="0"
                    Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="Dismiss" AutomationProperties.Name="Dismiss" Click="OnDismiss">
                <FontIcon FontSize="10" Glyph="&#xE8BB;" />
            </Button>
        </Grid>

        <!-- What went wrong, in one line -->
        <TextBlock x:Name="Headline" Grid.Row="1" Margin="0,0,8,0"
                   Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />

        <!-- Decoded error codes (filled in code), or a short excerpt when there are none -->
        <StackPanel x:Name="CodesPanel" Grid.Row="2" Spacing="6" Margin="0,0,8,0" />
        <TextBlock x:Name="Excerpt" Grid.Row="2" Margin="0,0,8,0" Visibility="Collapsed"
                   Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- AI explanation (opt-in). States: loading / explanation / unavailable / opt-in link. -->
        <StackPanel x:Name="AiPanel" Grid.Row="3" Spacing="6" Margin="0,0,8,0" Padding="10,8,10,10" CornerRadius="6"
                    Visibility="Collapsed" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="AiIcon" FontSize="12" Glyph="&#xE945;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock x:Name="AiHeader" Grid.Column="1" Text="Asking Gemini…" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ProgressRing x:Name="AiProgress" Grid.Column="2" Width="14" Height="14" IsActive="False" />
            </Grid>
            <TextBlock x:Name="AiCause" TextWrapping="Wrap" Visibility="Collapsed" Style="{StaticResource BodyTextBlockStyle}" />
            <StackPanel x:Name="AiSteps" Spacing="3" Visibility="Collapsed" />
            <Border x:Name="AiActionChip" Visibility="Collapsed" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left"
                    BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Background="{ThemeResource ControlFillColorDefaultBrush}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon x:Name="AiActionIcon" FontSize="12" Glyph="&#xE90F;" />
                    <TextBlock x:Name="AiActionText" FontSize="12" TextWrapping="Wrap" MaxWidth="250" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="AiNote" TextWrapping="Wrap" Visibility="Collapsed" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <HyperlinkButton x:Name="AiOptIn" Visibility="Collapsed" Padding="0" Click="OnAiOptIn">
                <TextBlock Text="Explain this with AI (asks first)…" Style="{StaticResource CaptionTextBlockStyle}" />
            </HyperlinkButton>
        </StackPanel>

        <!-- Where it came from + trust badge -->
        <Grid Grid.Row="4" Margin="0,2,8,0" Padding="0,8,0,0" ColumnSpacing="8" BorderThickness="0,1,0,0"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="BadgeIcon" FontSize="14" Glyph="&#xE73E;" VerticalAlignment="Top" Margin="0,2,0,0" />
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="SourceName" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="12"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="BadgeText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" MaxLines="2" />
            </StackPanel>
        </Grid>

        <!-- Expand / collapse full details -->
        <HyperlinkButton x:Name="DetailsToggle" Grid.Row="5" Padding="0,2" Margin="0,-2,0,0" Click="OnToggleDetails">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock x:Name="DetailsToggleText" Text="Show details" Style="{StaticResource CaptionTextBlockStyle}" />
                <FontIcon x:Name="DetailsChevron" FontSize="10" Glyph="&#xE70D;" />
            </StackPanel>
        </HyperlinkButton>

        <ScrollViewer x:Name="DetailsPanel" Grid.Row="6" Visibility="Collapsed" MaxHeight="260" Margin="0,0,4,2"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <RichTextBlock x:Name="DetailsText" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" Margin="0,0,8,0" />
        </ScrollViewer>
    </Grid>
</Window>
