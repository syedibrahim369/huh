<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Huh.BubbleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="huh">

    <Grid x:Name="Root" VerticalAlignment="Top" Padding="16,12,8,14" RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: severity glyph, brand, dismiss -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="SeverityIcon" FontSize="16" Glyph="&#xEB90;" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="huh?" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Name="DismissButton" Grid.Column="2" Width="32" Height="28" Padding="0"
                    Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="Dismiss" AutomationProperties.Name="Dismiss" Click="OnDismiss">
                <FontIcon FontSize="10" Glyph="&#xE8BB;" />
            </Button>
        </Grid>

        <!-- What the dialog is about -->
        <TextBlock x:Name="Headline" Grid.Row="1" Margin="0,0,8,0"
                   Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="Detail" Grid.Row="2" Margin="0,0,8,0"
                   Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- Where it came from -->
        <Grid Grid.Row="3" Margin="0,6,8,0" ColumnSpacing="6" BorderThickness="0,1,0,0" Padding="0,8,0,0"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon FontSize="12" Glyph="&#xECAA;" VerticalAlignment="Top" Margin="0,2,0,0"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="SourceName" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock x:Name="SourcePath" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
